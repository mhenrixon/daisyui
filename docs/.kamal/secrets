# Secrets for Kamal deployment
#
# GHCR auth comes from the GitHub Actions GITHUB_TOKEN at deploy time.
# Application secrets are fetched from 1Password via Kamal's adapter.
#
# Required env at deploy time:
#   - GITHUB_TOKEN              (provided automatically by GitHub Actions)
#   - OP_SERVICE_ACCOUNT_TOKEN  (configured as a GitHub environment secret)

KAMAL_REGISTRY_PASSWORD=$GITHUB_TOKEN

# Fetch all gem secrets from 1Password in one call
SECRETS=$(kamal secrets fetch \
  --adapter 1password \
  --account henriksson.1password.com \
  --from oss-infrastructure/daisyui-docs)

RAILS_MASTER_KEY=$(kamal secrets extract rails_master_key $SECRETS)
